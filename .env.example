GEMINI_API_KEY=your_gemini_api_key_here
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# Login con Google — crear en https://console.cloud.google.com/apis/credentials
# (tipo "ID de cliente de OAuth", tipo de app "Aplicación web"), con
# http://localhost:5001/auth/google/callback como URI de redirección autorizada.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# Clave para firmar la cookie de sesión. Cualquier string largo y aleatorio;
# si se deja vacía se genera una nueva en cada arranque (cierra la sesión
# de todos al reiniciar el server).
FLASK_SECRET_KEY=
