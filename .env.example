# --- Obligatorias para que la app arranque con sentido ---
FLASK_SECRET_KEY=cambia_esto_por_un_string_largo_y_aleatorio
GEMINI_API_KEY=your_gemini_api_key_here
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# Opcional: más fuentes de datos / IA
# API-Sports (api-sports.io) — distinto de iSports
APISPORTS_API_KEY=
# iSports (api.isportsapi.com / api2.isportsapi.com) — livescores + schedule
ISPORTS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
KIMI_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# Login con Google — https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth" → Aplicación web.
# URIs de redirección autorizadas (añade ambas si pruebas local + Render):
#   http://localhost:5001/auth/google/callback
#   https://TU-SERVICIO.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
